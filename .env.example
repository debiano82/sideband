# --- Esposizione sull'host ---
# A quale indirizzo pubblicare pannello e dashboard:
#   127.0.0.1 = solo loopback (NPM sull'host, o in host network)
#   0.0.0.0   = raggiungibile da fuori / da NPM in un'altra rete docker
# Se NPM e' un container su una rete sua, meglio ancora: usa la rete esterna
# (vedi il fondo di docker-compose.yml) e lascia 127.0.0.1.
BIND_ADDR=127.0.0.1

# --- Parse ---
PARSE_APP_ID=sideband
PARSE_MASTER_KEY=change-me-master-key
# porta INTERNA su cui ascolta Parse (dietro NPM; cambiala come vuoi)
PARSE_PORT=4000
# URL pubblico di Parse (via NPM): https://api.sideband.it/parse
PUBLIC_API_URL=https://api.sideband.it/parse

# --- Primo utente del pannello (creato/riallineato a ogni avvio di parse) ---
# Se l'utente non esiste viene creato; se esiste, la password viene riportata a
# questa. E' la via d'uscita se ti chiudi fuori: cambia qui e
# `docker compose restart parse`. Min 6 caratteri.
ADMIN_USER=admin
ADMIN_PASS=change-me-admin

# --- Parse Dashboard (dash.sideband.it) ---
# login HTTP Basic del dashboard (non c'entra con l'utente del pannello sopra)
DASH_USER=admin
DASH_PASS=change-me
# URL di Parse che il browser dell'admin deve poter aprire quando usa il
# dashboard. In locale lascia localhost; dietro NPM mettilo uguale a PUBLIC_API_URL.
DASHBOARD_API_URL=http://localhost:4000/parse

# --- Backend / WireGuard ---
# token condiviso Parse <-> helper (interno)
HELPER_TOKEN=change-me-helper-token
# endpoint pubblico WG che finisce nelle config client
WG_ENDPOINT=vpn.sideband.it:51820
# subnet della overlay VPN (server = .1)
WG_SUBNET=10.99.0.0/24
